# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,*

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://orderup_user:orderup_pass_2026@localhost:5432/orderup_db?schema=public

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_2026
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────────────────────
# Kenya Safaricom M-Pesa Integration (Daraja API)
# ─────────────────────────────────────────────────────────────
# Set to 'production' for live payments or 'sandbox' for testing
MPESA_ENVIRONMENT=sandbox

# Live Production Credentials (from https://developer.safaricom.co.ke -> Go Live -> Live Apps)
MPESA_CONSUMER_KEY=your_live_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_live_mpesa_consumer_secret

# Live Online Passkey (Requested under Lipa Na M-Pesa Online in live portal)
MPESA_PASSKEY=your_live_mpesa_passkey

# Active Shortcode:
# - Paybill Number (e.g. 123456) OR
# - Buy Goods Store/Till Number
MPESA_SHORTCODE=174379

# Transaction Type:
# - CustomerPayBillOnline (for Paybill shortcodes)
# - CustomerBuyGoodsOnline (for Buy Goods / Till Numbers)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Public HTTPS Callback URL where Safaricom sends transaction status
# MUST be publicly accessible over HTTPS (e.g. using ngrok for local dev, or domain in prod)
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/callback

# ─────────────────────────────────────────────────────────────
# Resend Email API & Portals
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="OrderUp <devops@sabacloud.co.ke>"
STAFF_PORTAL_URL=https://order-up-staffportal.vercel.app
ADMIN_PORTAL_URL=https://orderup-admin.vercel.app

